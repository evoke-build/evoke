{
  "description": "Control the lights of one room: on, off or dimmed.\nCeiling and lamp lights; scenes live elsewhere.",
  "not_for": [
    "colour scenes and schedules",
    "asking whether a light is on",
    "the TV backlight"
  ],
  "tags": [
    "home",
    "lighting"
  ],
  "effect": "write",
  "confirm": "Set the {room} lights {power}?",
  "run": "lights.mts",
  "config": {
    "bridge": {
      "about": "Hue bridge address",
      "secret": false
    },
    "token": {
      "about": "Hue API key",
      "secret": true
    }
  },
  "args": {
    "room": {
      "ask": "Which room?",
      "vocab": "rooms",
      "optional": false,
      "was": []
    },
    "power": {
      "ask": "What should the lights do?",
      "options": {
        "on": "Switch on.",
        "off": "Switch off.",
        "dim": "Lower the brightness; the lights stay on."
      },
      "optional": false,
      "was": [
        "state"
      ]
    },
    "brightness": {
      "ask": "How bright, in percent?",
      "pick": "number",
      "range": [
        1,
        100
      ],
      "optional": true,
      "was": []
    }
  },
  "examples": {
    "turn on the kitchen lights": {
      "power": "on"
    },
    "dim the office to 30 percent": {
      "power": "dim",
      "brightness": "30 percent"
    }
  },
  "tests": {
    "make it darker in here": {
      "power": "dim"
    },
    "light a candle": false
  },
  "unknown": []
}
