{
  "effect": "write",
  "run": "lights.mts",
  "confirm": "Set the {room} lights {state}?",
  "args": {
    "room": {
      "ask": "Which room?",
      "vocab": "rooms",
      "optional": false,
      "was": []
    },
    "state": {
      "ask": "What should the lights do?",
      "options": {
        "on": "Switch on.",
        "off": "Switch off.",
        "dim": "Lower the brightness without switching off."
      },
      "optional": false,
      "was": []
    },
    "brightness": {
      "ask": "How bright, in percent?",
      "pick": "number",
      "range": [
        1,
        100
      ],
      "optional": true,
      "was": []
    }
  },
  "config": {
    "bridge": {
      "type": "plain",
      "value": "10.0.0.2"
    },
    "token": {
      "type": "env",
      "var": "HUE_TOKEN"
    }
  },
  "tags": [
    "home",
    "lighting"
  ]
}
