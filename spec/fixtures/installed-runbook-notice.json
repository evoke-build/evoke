      },
      "consented": "destructive",
      "configured": {}
    },
    "verify": {
      "wording": {
        "ok": {
          "manifest": {
            "description": "Check that writes land on the current primary.\nAnswers yes or no.",
            "not_for": [
              "draining",
              "promoting"
            ],
            "tags": [
              "verify"
            ],
            "effect": "read",
            "confirm": "Check writes?",
            "run": "verify.mts",
            "config": {
              "landing": {
                "about": "Whether writes land on the new primary: yes or no.",
                "secret": false
              }
            },
            "args": {},
            "yields": {
              "landing": "quoted"
            },
            "examples": {
              "check that writes land on the new primary": {},
              "are writes landing": {}
            },
            "tests": {},
            "unknown": []
          },
          "yours": []
        }
      },
      "consented": "read",
      "configured": {
        "landing": {
          "type": "plain"
        }
      }
    },
    "tell": {
      "wording": {
        "ok": {
          "manifest": {
            "description": "Tell a chat channel where things stand.\nThe message is what you typed about it.",
