{
  "reflexes": {
    "drain": {
      "wording": {
        "ok": {
          "manifest": {
            "description": "Drain traffic from the primary database.\nNew connections go to the replica; open ones finish.",
            "not_for": [
              "promoting the replica",
              "checking writes"
            ],
            "tags": [
              "drain"
            ],
            "effect": "write",
            "confirm": "Drain the primary?",
            "run": "drain.mts",
            "config": {},
            "args": {},
            "yields": {},
            "examples": {
              "drain connections off the primary": {},
              "stop new connections to the primary": {}
            },
            "tests": {},
            "unknown": []
          },
          "yours": []
        }
      },
      "consented": "write",
      "configured": {}
    },
    "failover": {
      "wording": {
        "ok": {
          "manifest": {
            "description": "Promote the replica to primary.\nThe old primary is demoted; it cannot be undone from here.",
            "not_for": [
              "draining connections",
              "checking writes"
            ],
            "tags": [
              "failover"
            ],
            "effect": "destructive",
            "confirm": "Promote the replica now?",
            "run": "failover.mts",
            "config": {},
