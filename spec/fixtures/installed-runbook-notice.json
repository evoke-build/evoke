    "failback": {
      "wording": {
        "ok": {
          "manifest": {
            "description": "Fail back to the old primary.\nThe replica is demoted again; it cannot be undone from here.",
            "not_for": [
              "failing over",
              "checking writes"
            ],
            "tags": [
              "failback"
            ],
            "effect": "destructive",
            "confirm": "Fail back to the old primary?",
            "run": "failback.mts",
            "config": {},
            "args": {},
            "yields": {},
            "examples": {
              "fail back to the old primary": {},
              "go back to the old primary": {}
            },
            "tests": {},
            "unknown": []
          },
          "yours": []
        }
      },
      "consented": "destructive",
      "configured": {}
    },
    "runbook": {
      "wording": {
        "ok": {
          "manifest": {
            "description": "Fail the database over to its replica.\nDrains the primary, promotes the replica and checks that writes land on it; tells the ops channel when they do, fails back when they do not.",
            "not_for": [
              "draining the primary on its own",
              "checking writes on their own",
              "a replica that is primary already"
            ],
            "tags": [
              "failover"
            ],
            "effect": "destructive",
            "confirm": "Run the failover runbook?",
            "steps": [
              "drain connections off the primary",
              "fail over to the replica",
              "check whether writes land on the new primary",
              {
                "say": "tell the ops channel the failover is done",
                "when": {
                  "landing": "yes"
                }
              },
              {
                "say": "fail back to the old primary",
                "when": {
                  "landing": "no"
                }
              },
              "record the notice"
            ],
            "config": {},
            "args": {},
            "yields": {},
            "examples": {
              "run the failover runbook": {},
              "switch the database to the replica": {},
              "the primary is dying, fail over": {}
            },
            "tests": {
              "drain the primary": {}
            },
            "unknown": []
          },
          "yours": []
        }
      },
      "consented": "destructive",
      "configured": {}
    },
    "record": {
      "wording": {
        "ok": {
          "manifest": {
