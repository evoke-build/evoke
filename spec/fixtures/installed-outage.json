  "reflexes": {
    "errors": {
      "wording": {
        "ok": {
          "manifest": {
            "description": "Show the error rate of a service.\nThe share of its requests failing over the last hour and when it rose, in one region or all.",
            "not_for": [
              "the error messages in a service's logs",
              "what was deployed and when",
              "a service that is down or broken",
              "response times and latency"
            ],
            "tags": [
              "errors",
              "outage"
            ],
            "effect": "read",
            "confirm": "Show the error rate of {service}?",
            "run": "errors.mts",
            "config": {},
            "args": {
              "service": {
                "ask": "Which service?",
                "vocab": "services",
                "optional": false,
                "was": []
              },
              "region": {
                "ask": "In which region?",
                "vocab": "regions",
                "optional": true,
                "was": []
              }
            },
            "yields": {},
            "returns": "errors",
            "examples": {
              "check the errors for checkout": {},
              "error rate of payments in eu-west": {},
              "is search throwing errors": {},
              "how many checkout requests are erroring": {},
              "show me the 5xx on search in us-east": {},
              "what is the error rate of checkout": {},
              "is search failing in us east": {}
            },
            "tests": {
              "how flaky is payments right now": {},
              "any timeouts in the checkout logs": false,
              "what version is search on": false,
              "search just went down": false,
              "why is checkout so slow": false
            },
            "unknown": []
          },
          "yours": []
        }
      },
      "consented": "read",
      "configured": {}
