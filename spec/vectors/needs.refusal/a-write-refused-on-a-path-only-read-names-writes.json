{
  "input": {
    "policy": { "reads": [{ "path": "/Users/me/notes", "from": "~/notes" }] },
    "reflex": "note",
    "origin": { "type": "local", "at": { "file": { "type": "manifest", "name": "note" }, "line": 10, "column": 1 } },
    "refused": { "what": "open", "path": "/Users/me/notes/today.txt" },
    "home": "/Users/me"
  },
  "expect": {
    "reflex": "note",
    "message": "~/notes/today.txt is not in [needs] writes",
    "fix": { "type": "edit_line", "at": { "file": { "type": "manifest", "name": "note" }, "line": 10, "column": 1 } }
  }
}
