{
  "input": {
    "previous": {
      "$ref": "fixtures/lights.json"
    },
    "next": {
      "description": "Turn the lights in one room on, off, or dim them.\nCeiling and lamp lights only.",
      "not_for": [
        "colour scenes and schedules",
        "asking whether a light is on"
      ],
      "tags": [
        "home",
        "lighting"
      ],
      "effect": "write",
      "confirm": "Set the {room} lights {state}?",
      "run": "lights.mts",
      "config": {
        "bridge": {
          "about": "Hue bridge address",
          "secret": false
        },
        "token": {
          "about": "Hue API key",
          "secret": true
        },
        "room_default": {
          "about": "The room when none is named",
          "secret": false
        }
      },
      "args": {
        "room": {
          "ask": "Which room?",
          "vocab": "rooms",
          "optional": false,
          "was": []
        },
        "state": {
          "ask": "What should the lights do?",
          "options": {
            "on": "Switch on.",
            "off": "Switch off.",
            "dim": "Lower the brightness without switching off.",
            "toggle": "Flip it."
          },
          "optional": false,
          "was": []
        },
        "brightness": {
          "ask": "How bright, in percent?",
          "pick": "number",
          "range": [
            1,
            100
          ],
          "optional": true,
          "was": []
        },
        "fade": {
          "ask": "Over how many seconds?",
          "pick": "duration",
          "optional": true,
          "was": []
        }
      },
      "yields": {},
      "examples": {
        "turn on the kitchen lights": {
          "state": "on"
        },
        "dim the office to 30 percent": {
          "state": "dim",
          "brightness": "30 percent"
        }
      },
      "tests": {
        "make it darker in here": {
          "state": "dim"
        },
        "light a candle": false
      },
      "unknown": []
    }
  },
  "expect": {
    "level": "minor",
    "changes": [
      {
        "type": "option_added",
        "arg": "state",
        "key": "toggle"
      },
      {
        "type": "arg_added",
        "arg": "fade"
      },
      {
        "type": "config_added",
        "key": "room_default"
      }
    ],
    "violations": []
  }
}
