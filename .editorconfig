root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# rustfmt's default, and the Python tasks' own
[*.rs]
indent_size = 4

[{*.py,mise-tasks/changelog,mise-tasks/lint-spec,mise-tasks/site}]
indent_size = 4
