#!/usr/bin/env python3
"""The last lines of a test log as one error annotation on the job, so a failed flow's diff is read from the run's
page without a login: python3 .github/annotate test.log"""

import sys

with open(sys.argv[1], errors="replace") as log:
    text = log.read()[-3800:]
encoded = text.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")
print(f"::error title=the test log's last lines::{encoded}")
