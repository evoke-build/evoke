#!/usr/bin/env python3
#MISE description="Build evoke.build into target/site: the landing page and the use-cases page, the install script, the manual rendered by mdBook with the site's bar and the six sentences on every page, a canonical link, a description, a card and a breadcrumb trail on every page, the sitemap dated by git, and robots.txt — checking first that every link in the manual resolves"
"""The manual's README is its index: its tables become mdBook's SUMMARY.md, so the site's structure has one source.
What a search engine or a shared link needs is written here, once, from the pages themselves and from git."""
import html as html_text, json, re, shutil, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MANUAL, SITE, OUT, SRC = ROOT / "docs/manual", ROOT / "site", ROOT / "target/site", ROOT / "target/site-src"
URL = "https://evoke.build/"
CARD = URL + "og.png"
CARD_ALT = "evoke — Software, by reflex."
LINK = re.compile(r"\[([^\]]*)\]\(([^)\s]+)\)")
UNLISTED = {"404.html", "print.html", "toc.html"}


def links_resolve():
    """Every relative link in the manual names a page of the manual — the site, like the repository, is whole."""
    problems = []
    for page in sorted(MANUAL.rglob("*.md")):
        for _, target in LINK.findall(page.read_text()):
            path = target.split("#")[0]
            if not path or path.startswith(("http://", "https://")):
                continue
            file = (page.parent / path).resolve()
            if not (file.is_file() and file.is_relative_to(MANUAL)):
                problems.append(f"{page.relative_to(ROOT)}: {target} is not a page of the manual")
    if problems:
        sys.exit("\n".join(problems))


def summary():
    """SUMMARY.md from the README: the README first, then each `###` section as a part, each table row a page."""
    lines = ["[The manual](README.md)", ""]
    manual = (MANUAL / "README.md").read_text().split("\n## The manual\n", 1)[1].split("\n## ", 1)[0]
    for line in manual.splitlines():
        if line.startswith("### "):
            lines += ["", f"# {line[4:]}", ""]
        elif line.startswith("| [") and (link := LINK.search(line)):
            lines.append(f"- [{link[1]}]({link[2]})")
    return "\n".join(lines) + "\n"


def address(page):
    """The page's public address: a directory's index is the directory."""
    rel = page.relative_to(OUT).as_posix()
    return URL + (rel[: -len("index.html")] if rel.endswith("index.html") else rel)


def source(page):
    """The file in the repository a built page comes from."""
    rel = page.relative_to(OUT).as_posix()
    if "/" not in rel:
        return SITE / rel
    if rel == "manual/index.html":
        return MANUAL / "README.md"
    return MANUAL / (rel[len("manual/") : -len(".html")] + ".md")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, cwd=ROOT).stdout.strip()


def description(page_html):
    """The page's first paragraph, as one line of at most 160 characters, ending at a word."""
    main = page_html.split("<main", 1)[-1]
    found = re.search(r"<p>(.*?)</p>", main, re.S)
    if not found:
        return None
    text = " ".join(html_text.unescape(re.sub(r"<[^>]+>", "", found[1])).split())
    if len(text) > 160:
        text = text[:157].rsplit(" ", 1)[0].rstrip(",;:—-") + "…"
    return text


def trail(page, name):
    """The page's place, for a search engine: evoke, the manual, the page. The last step needs no address."""
    steps = [{"@type": "ListItem", "position": 1, "name": "evoke", "item": URL}]
    if page != OUT / "manual/index.html":
        steps.append({"@type": "ListItem", "position": 2, "name": "Manual", "item": URL + "manual/"})
    steps.append({"@type": "ListItem", "position": len(steps) + 1, "name": name})
    return json.dumps({"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": steps}, ensure_ascii=False)


def described(page):
    """A manual page with what a search engine and a shared link read: canonical, description, the card, the trail."""
    text = page.read_text()
    titled = re.search(r"<title>(.*?)</title>", text)
    if page.name in UNLISTED or titled is None:
        page.write_text(text.replace("</head>", '<meta name="robots" content="noindex">\n</head>', 1))
        return
    title = html_text.unescape(titled[1])
    name = title.removesuffix(" - evoke")
    summary_line = description(text) or re.search(r'<meta name="description" content="([^"]*)">', text)[1]
    quoted = html_text.escape(summary_line, quote=True)
    heading = html_text.escape(title, quote=True)
    head = "\n".join([
        f'<link rel="canonical" href="{address(page)}">',
        '<meta name="robots" content="max-image-preview:large">',
        '<meta property="og:type" content="article">',
        '<meta property="og:site_name" content="evoke">',
        '<meta property="og:locale" content="en_US">',
        f'<meta property="og:title" content="{heading}">',
        f'<meta property="og:description" content="{quoted}">',
        f'<meta property="og:url" content="{address(page)}">',
        f'<meta property="og:image" content="{CARD}">',
        '<meta property="og:image:width" content="2400">',
        '<meta property="og:image:height" content="1260">',
        f'<meta property="og:image:alt" content="{CARD_ALT}">',
        '<meta name="twitter:card" content="summary_large_image">',
        f'<meta name="twitter:title" content="{heading}">',
        f'<meta name="twitter:description" content="{quoted}">',
        f'<meta name="twitter:image" content="{CARD}">',
        f'<meta name="twitter:image:alt" content="{CARD_ALT}">',
        f'<script type="application/ld+json">{trail(page, name)}</script>',
        "</head>",
    ])
    text = re.sub(r'<meta name="description" content="[^"]*">', f'<meta name="description" content="{quoted}">', text, count=1)
    page.write_text(text.replace("</head>", head, 1))


AT_WORK = """                    <aside class="at-work" aria-label="The use cases">
                        <div class="words">
                            <p class="label">At work</p>
                            <h2>Six sentences, at work.</h2>
                            <p>Real sessions from an ops channel, an inbox, a payments desk, a plant floor, a runbook and
                                a lesson. Each one as files anyone can install, and as code your app keeps.</p>
                            <a class="go" href="{root}use-cases.html">See them run &rarr;</a>
                        </div>
                        <ul class="said">
                            <li><a href="{root}use-cases.html#ops"><i>$</i> evoke "scale checkout to 6 in staging"</a></li>
                            <li><a href="{root}use-cases.html#stream"><i>$</i> evoke &lt; inbox.txt</a></li>
                            <li><a href="{root}use-cases.html#bank"><i>$</i> evoke "pay Acme 12400 from ops"</a></li>
                            <li><a href="{root}use-cases.html#plant"><i>$</i> evoke "the filler is jammed, stop it"</a></li>
                            <li><a href="{root}use-cases.html#runbook"><i>$</i> node runbook.ts "drain the primary"</a></li>
                            <li><a href="{root}use-cases.html#teach"><i>$</i> evoke "make db-3 shut up for 90 minutes"</a></li>
                        </ul>
                    </aside>
"""


def furnished(page):
    """A manual page furnished: the brand in the bar leads home, a Use cases link joins the bar, and the six sentences
    close the page. The pages nobody lands on, print and 404, stay bare."""
    if page.name in UNLISTED:
        return
    text = page.read_text()
    root = "../" * (len(page.relative_to(OUT / "manual").parts) - 1) + "../"
    text = text.replace('<h1 class="menu-title">evoke</h1>', f'<h1 class="menu-title"><a href="{root}">evoke</a></h1>', 1)
    text = text.replace('<div class="right-buttons">\n', f'<div class="right-buttons">\n                        <a class="use-cases" href="{root}use-cases.html">Use cases</a>\n', 1)
    text = text.replace("                    </main>", AT_WORK.replace("{root}", root) + "                    </main>", 1)
    page.write_text(text)


def versioned(landing):
    """The landing page's structured data names the version Cargo.toml names."""
    version = re.search(r'^version\s*=\s*"([^"]+)"', (ROOT / "Cargo.toml").read_text(), re.M)[1]
    landing.write_text(re.sub(r'"softwareVersion": "[^"]*"', f'"softwareVersion": "{version}"', landing.read_text(), count=1))


def sitemap(pages):
    """Every listed page, dated by the last commit that touched its source. A clone without history dates nothing:
    a search engine trusts a date only while every date is right."""
    dated = git("rev-parse", "--is-shallow-repository") == "false"
    entries = []
    for page in pages:
        date = git("log", "-1", "--format=%cs", "--", str(source(page))) if dated else ""
        entries.append(f"  <url><loc>{address(page)}</loc>{f'<lastmod>{date}</lastmod>' if date else ''}</url>")
    (OUT / "sitemap.xml").write_text(
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n' + "\n".join(entries) + "\n</urlset>\n")
    (OUT / "robots.txt").write_text(f"User-agent: *\nAllow: /\nDisallow: /manual/print.html\n\nSitemap: {URL}sitemap.xml\n")
    return dated


links_resolve()
shutil.rmtree(OUT, ignore_errors=True)
shutil.rmtree(SRC, ignore_errors=True)
shutil.copytree(MANUAL, SRC)
(SRC / "SUMMARY.md").write_text(summary())
subprocess.run(["mdbook", "build", str(SITE)], check=True)
for name in ["index.html", "use-cases.html", "install.sh", "og.png", "logo.png", "logo-512.png", "apple-touch-icon.png"]:
    shutil.copy(SITE / name, OUT / name)
shutil.copy(SITE / "theme/favicon.png", OUT / "favicon.png")
shutil.copytree(ROOT / "assets", OUT / "assets")
shutil.copytree(SITE / "fonts", OUT / "fonts")
versioned(OUT / "index.html")
manual_pages = sorted(OUT.glob("manual/**/*.html"))
for page in manual_pages:
    furnished(page)
    described(page)
shutil.copy(OUT / "manual/404.html", OUT / "404.html")
listed = [OUT / "index.html", OUT / "use-cases.html", OUT / "manual/index.html"] + [p for p in manual_pages if p.name not in UNLISTED and p != OUT / "manual/index.html"]
dated = sitemap(listed)
print(f"site: {OUT.relative_to(ROOT)} — {len(listed)} pages in the sitemap{'' if dated else ', undated: the clone has no history'}")
