#!/usr/bin/env python3
# MISE description="Build evoke.build into target/site: the pages with their shared bar and footer, the manual by mdBook, the schemas, llms.txt and the sitemap; the manual's links checked first, every link and address last"
"""Build evoke.build into target/site: the site's pages, each given the shared head, bar and footer from site/parts,
the example pages beside them, the FAQ with its questions as structured data, the privacy policy dated by git, the
install script, the manual rendered by mdBook with the site's links, the examples' sentences and the FAQ and privacy
links on every page, a canonical link, a description, a card and a breadcrumb trail on every page, the manual's
markdown beside each page, llms.txt and llms-full.txt for a language model, the sitemap dated by git, and
robots.txt. It checks first that every link in the manual resolves, and last that every link on every built page
lands on a file and an anchor it has, and that every address the two files name is served.

The manual's README is its index: its tables become mdBook's SUMMARY.md, so the site's structure has one source.
What a search engine or a shared link needs is written here, once, from the pages themselves and from git."""

import datetime
import html as html_text
import json
import re
import shutil
import subprocess
import sys
from html.parser import HTMLParser
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MANUAL, SITE, OUT, SRC = ROOT / "docs/manual", ROOT / "site", ROOT / "target/site", ROOT / "target/site-src"
URL = "https://evoke.build/"
CARD = URL + "og.jpg"
CARD_ALT = "evoke — Software, by reflex."
# A page's own card, declared in its head, 1200×630 at twice the size like og.jpg
OWN_CARD = re.compile(r'[ \t]*<meta property="og:image" content="([^"]*)">\n')
OWN_ALT = re.compile(r'[ \t]*<meta property="og:image:alt" content="([^"]*)">\n')
THEME = re.compile(r'[ \t]*<meta name="theme-color" content="[^"]*">\n')
LINK = re.compile(r"\[([^\]]*)\]\(([^)\s]+)\)")
TOKEN = re.compile(r"--([a-z-]+):\s*([^;]+);")
UNLISTED = {"404.html", "print.html", "toc.html"}
UNINDEXED = {"404.html", "use-cases.html"}  # the page for an address that is not there, and one that sends readers on
BRAND = re.compile(r"^evoke - |\s+-\s+evoke(?: manual)?$", re.IGNORECASE)
SETTINGS = re.compile(r"\A(?:<!-- (?:title|description): .+? -->\n)+")
FLOW = re.compile(r'<pre[^>]*\sdata-flow="([\w-]+)"[^>]*>(.*?)</pre>', re.DOTALL)
PARTS = SITE / "parts"
ID = re.compile(r'\sid="([^"]+)"')
HREF = re.compile(r'\s(?:href|src)="([^"]+)"')
SITE_URL = re.compile(r"https://evoke\.build/[^\s)\]<>\"'`]*")
ARTICLE = re.compile(r"(?<![\w-])(a|an|the|A|An|The) (?=\w)")
VERSION = re.search(r'^version\s*=\s*"([^"]+)"', (ROOT / "Cargo.toml").read_text(), re.MULTILINE)[1]


def links_resolve():
    """Every relative link in the manual names a page of the manual — the site, like the repository, is whole."""
    problems = []
    for page in sorted(MANUAL.rglob("*.md")):
        for _, target in LINK.findall(page.read_text()):
            path = target.split("#")[0]
            if not path or path.startswith(("http://", "https://")):
                continue
            file = (page.parent / path).resolve()
            if not (file.is_file() and file.is_relative_to(MANUAL)):
                problems.append(f"{page.relative_to(ROOT)}: {target} is not a page of the manual")
    if problems:
        sys.exit("\n".join(problems))


def site_palette():
    """The site's palette, from its stylesheet, and a check that the manual and any page declaring a colour keep to
    it: a colour declared under the stylesheet's name carries the stylesheet's value, so nothing drifts apart."""

    def tokens(file):
        block = re.search(r":root\s*\{(.*?)\}", file.read_text(), re.DOTALL)
        if block is None:
            return {}
        return {
            name: value.strip() for name, value in TOKEN.findall(block[1]) if value.lstrip().startswith(("#", "rgb"))
        }

    shared = tokens(SITE / "site.css")
    problems = [
        f"{file.relative_to(ROOT)}: --{name} is {value}, the stylesheet's is {shared[name]}"
        for file in [SITE / "manual.css", *pages()]
        for name, value in tokens(file).items()
        if name in shared and value != shared[name]
    ]
    if problems:
        sys.exit("\n".join(problems))
    return shared


def recorded():
    """Every line the home page's walkthrough shows as printed, a terminal line or a judgment quoted under it, is a
    line the binary printed in the weave flow, whose transcript the tests replay: the page shows nothing invented."""
    session = (ROOT / "spec/transcripts/weave/session.txt").read_text().splitlines()
    page = (SITE / "index.html").read_text()
    start, end = page.find('<div class="walk"'), page.find("<!-- /walk -->")
    if start < 0 or end < start:
        sys.exit('site/index.html: no walkthrough between <div class="walk" and <!-- /walk -->')
    walk = page[start:end]

    class Quoted(HTMLParser):  # an element left open, as a void one is, closes with its parent
        def __init__(self):
            super().__init__(convert_charrefs=True)
            self.open, self.found = [], []

        def handle_starttag(self, tag, attrs):
            classes, kind = (dict(attrs).get("class") or "").split(), {"span": "line", "code": "said"}.get(tag, "")
            self.open.append([tag, kind if kind in classes else "", []])

        def handle_endtag(self, tag):
            while self.open:
                name, kind, text = self.open.pop()
                if kind:
                    self.found.append((kind, "".join(text)))
                if self.open:
                    self.open[-1][2].extend(text)
                if name == tag:
                    break

        def handle_data(self, data):
            if self.open:
                self.open[-1][2].append(data)

    quoted = Quoted()
    quoted.feed(walk)
    lines, stripped = {line.rstrip() for line in session}, {line.strip() for line in session}
    problems = [
        f"site/index.html: the walkthrough shows {text!r}, which the weave transcript never printed"
        for kind, text in quoted.found
        if not (
            text.rstrip() in lines
            if kind == "line"
            else text in stripped or any(line.startswith("{") and text in line for line in session)
        )
    ]
    if not quoted.found:
        problems.append("site/index.html: the walkthrough shows no printed line")
    if problems:
        sys.exit("\n".join(problems))


def pinned():
    """Every terminal a site page pins to a flow, `<pre data-flow="<flow>">`, shows only lines that flow printed in
    spec/transcripts/<flow>/session.txt, the transcript the tests replay: a page quotes the binary, never a memory of
    it. A line of … stands for the lines a panel leaves out."""
    problems = []
    for page in pages():
        for flow, pre in FLOW.findall(page.read_text()):
            session = ROOT / "spec/transcripts" / flow / "session.txt"
            if not session.is_file():
                problems.append(f"{page.relative_to(ROOT)}: data-flow names {flow!r}, a flow with no transcript")
                continue
            printed = {line.rstrip() for line in session.read_text().splitlines()}
            for line in html_text.unescape(re.sub(r"<[^>]+>", "", pre)).splitlines():
                if line.strip() not in ("", "…") and line.rstrip() not in printed:
                    problems.append(
                        f"{page.relative_to(ROOT)}: {line.rstrip()!r} is not a line the {flow} flow printed"
                    )
    if problems:
        sys.exit("\n".join(problems))


def pages():
    """The site's own pages: every page under site/, site/examples/ and site/guides/, but the social card's source."""
    found = [*sorted(SITE.glob("*.html")), *sorted(SITE.glob("examples/*.html")), *sorted(SITE.glob("guides/*.html"))]
    return [p for p in found if p.name != "og.html"]


def assembled(page):
    """A site page made whole: the shared head, bar and footer from site/parts in place of their markers, the bar
    marking the page it is on. A page missing a marker is a page that would ship without its furniture."""
    text = page.read_text()
    here = "/" + page.relative_to(OUT).as_posix().removesuffix("index.html")
    bar = (PARTS / "bar.html").read_text()
    bar = bar.replace(f'href="{here}"', f'href="{here}" aria-current="page"', 1)
    if here.startswith("/examples/"):
        bar = bar.replace('href="/examples.html"', 'href="/examples.html" aria-current="true"', 1)
    head_part = (PARTS / "head.html").read_text().rstrip("\n")
    if 'name="theme-color"' in text:  # a page in a colour of its own names it once
        head_part = THEME.sub("", head_part, count=1)
    for marker, part in (
        ("<!-- head -->", head_part),
        ("<!-- bar -->", bar.rstrip("\n")),
        ("<!-- footer -->", (PARTS / "footer.html").read_text().rstrip("\n")),
    ):
        if marker not in text:
            sys.exit(f"{page.relative_to(OUT)}: no {marker} marker")
        text = text.replace(marker, part.strip("\n"), 1)
    page.write_text(text)


def contents():
    """The manual's table of contents, from the README: each page's part, title, path and the README's own line on
    when to read it, in reading order. SUMMARY.md, llms.txt and llms-full.txt all follow it."""
    rows, part = [], None
    manual = (MANUAL / "README.md").read_text().split("\n## The manual\n", 1)[1].split("\n## ", 1)[0]
    for line in manual.splitlines():
        if line.startswith("### "):
            part = line[4:]
        elif line.startswith("| [") and (link := LINK.search(line)):
            rows.append((part, link[1], link[2], line.strip().strip("|").split("|")[1].strip()))
    return rows


def summary():
    """SUMMARY.md from the README: the README first, then each `###` section as a part, each table row a page."""
    lines, part = ["[The manual](README.md)", ""], None
    for section, title, path, _ in contents():
        if section != part:
            lines += ["", f"# {section}", ""]
            part = section
        lines.append(f"- [{title}]({path})")
    return "\n".join(lines) + "\n"


def address(page):
    """The page's public address: a directory's index is the directory."""
    rel = page.relative_to(OUT).as_posix()
    return URL + (rel.removesuffix("index.html"))


def published(page):
    """The address of the page a manual source is made into."""
    rel = page.relative_to(MANUAL).as_posix()
    return URL + "manual/" + ("" if rel == "README.md" else rel[: -len(".md")] + ".html")


def markdown(page):
    """The address of a built manual page's markdown twin."""
    url = address(page)
    return url + "index.md" if url.endswith("/") else url[: -len(".html")] + ".md"


def source(page):
    """The file in the repository a built page comes from."""
    rel = page.relative_to(OUT).as_posix()
    if not rel.startswith("manual/"):
        return SITE / rel
    if rel == "manual/index.html":
        return MANUAL / "README.md"
    return MANUAL / (rel[len("manual/") : -len(".html")] + ".md")


def git(*args):
    """What git printed, or nothing: a date git cannot give is an empty string, and the caller says so."""
    return subprocess.run(["git", *args], capture_output=True, text=True, cwd=ROOT, check=False).stdout.strip()


def description(page_html):
    """The page's first paragraph as one line of at most 160 characters: whole sentences when they fit, else cut at a
    word. A last sentence that introduces a block — it ends in a colon, a comma or a dash — reads as a stray line on a
    card, so it is dropped when a sentence precedes it and closed with a period when it is alone. None when the page
    has no paragraph."""
    main = page_html.split("<main", 1)[-1]
    found = re.search(r"<p>(.*?)</p>", main, re.DOTALL)
    if not found:
        return None
    text = " ".join(html_text.unescape(re.sub(r"<[^>]+>", "", found[1])).split())
    if text.endswith((":", ",", "—", "-")):
        sentences = re.split(r"(?<=[.!?])\s+", text)
        text = " ".join(sentences[:-1]) if len(sentences) > 1 else text.rstrip(":,—- ") + "."
    if len(text) > 160:
        whole = re.match(r"(.{50,159}[.!?])\s", text)
        text = whole[1] if whole else text[:157].rsplit(" ", 1)[0].rstrip(",;:—-") + "…"
    return text


def trail(page, name):
    """The page's place, for a search engine: evoke, then the manual, the examples or the guides where the page is
    one of them, then the page, named without the brand. The last step needs no address."""
    steps = [{"@type": "ListItem", "position": 1, "name": "Evoke", "item": URL}]
    rel = page.relative_to(OUT).as_posix()
    folders = [
        ("manual/", "Manual", "manual/"),
        ("examples/", "Examples", "examples.html"),
        ("guides/", "Guides", "guides.html"),
    ]
    for folder, label, item in folders:
        if rel.startswith(folder) and address(page) != URL + item:
            steps.append({"@type": "ListItem", "position": 2, "name": label, "item": URL + item})
    steps.append({"@type": "ListItem", "position": len(steps) + 1, "name": name})
    return json.dumps(
        {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": steps}, ensure_ascii=False
    )


def settings(markdown_page):
    """What a manual page sets for its search result on its first lines: `<!-- title: … -->`, the name its title
    shows where the index's would read badly in a result, and `<!-- description: … -->`, the line under it where the
    first paragraph would. The comments are the page's own, stripped wherever its markdown is published."""
    head = SETTINGS.match(markdown_page.read_text())
    return dict(re.findall(r"<!-- (title|description): (.+?) -->", head[0])) if head else {}


def described(page):
    """A page with what a search engine and a shared link read: title, canonical, description, the card, the trail. A
    manual page is titled by its name in the index and described by its first paragraph, unless it sets either; a
    site page by what it carries. The pages nobody should land on from a search are marked so."""
    text = page.read_text()
    titled = re.search(r"<title>(.*?)</title>", text)
    manual = page.relative_to(OUT).parts[0] == "manual"
    if page.name in (UNLISTED if manual else UNINDEXED) or titled is None:
        page.write_text(text.replace("</head>", '<meta name="robots" content="noindex">\n</head>', 1))
        return
    title = html_text.unescape(titled[1])
    own = settings(source(page)) if manual else {}
    name = own.get("title", BRAND.sub("", title))
    front = page == OUT / "manual/index.html"
    if manual:
        title = f"{name} - Evoke" if front else f"{name} - Evoke manual"
        text = text.replace(titled[0], f"<title>{html_text.escape(title, quote=False)}</title>", 1)
    carried = re.search(r'<meta name="description" content="([^"]*)">', text)
    summary_line = (
        own.get("description", description(text)) if manual else (html_text.unescape(carried[1]) if carried else None)
    )
    if summary_line is None:
        sys.exit(f"{page.relative_to(OUT)}: nothing to describe the page by")
    quoted = html_text.escape(summary_line, quote=True)
    heading = html_text.escape(title, quote=True)
    home = page == OUT / "index.html"
    card, alt = CARD, CARD_ALT
    own_card, own_alt = OWN_CARD.search(text), OWN_ALT.search(text)
    if own_card and own_alt:  # a page with a card of its own declares it once; the build says it with the rest
        card, alt = own_card[1], own_alt[1]
        text = text.replace(own_card[0], "", 1).replace(own_alt[0], "", 1)
    head = "\n".join(
        [
            f'<link rel="canonical" href="{address(page)}">',
            *([f'<link rel="alternate" type="text/markdown" href="{markdown(page)}">'] if manual else []),
            '<meta name="robots" content="max-image-preview:large">',
            f'<meta property="og:type" content="{"website" if home else "article"}">',
            '<meta property="og:site_name" content="Evoke">',
            '<meta property="og:locale" content="en_US">',
            f'<meta property="og:title" content="{heading}">',
            f'<meta property="og:description" content="{quoted}">',
            f'<meta property="og:url" content="{address(page)}">',
            f'<meta property="og:image" content="{card}">',
            f'<meta property="og:image:type" content="image/{"jpeg" if card.endswith(".jpg") else "png"}">',
            '<meta property="og:image:width" content="2400">',
            '<meta property="og:image:height" content="1260">',
            f'<meta property="og:image:alt" content="{alt}">',
            '<meta name="twitter:card" content="summary_large_image">',
            f'<meta name="twitter:title" content="{heading}">',
            f'<meta name="twitter:description" content="{quoted}">',
            f'<meta name="twitter:image" content="{card}">',
            f'<meta name="twitter:image:alt" content="{alt}">',
            *(
                []
                if home
                else [f'<script type="application/ld+json">{trail(page, "Manual" if front else name)}</script>']
            ),
            "</head>",
        ]
    )
    if manual:
        text = re.sub(
            r'<meta name="description" content="[^"]*">', f'<meta name="description" content="{quoted}">', text, count=1
        )
    page.write_text(text.replace("</head>", head, 1))


