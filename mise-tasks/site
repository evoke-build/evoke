def furnished(page):
    """A manual page furnished: the browser's chrome takes the page's colour; the bar carries the wordmark as plain text,
    so the title stays the page's one heading, and it leads home; the site's pages join the bar; the examples' sentences
    close the page after its previous and next, with the FAQ, the privacy policy and the repository in a line under
    them; its edit link names the source, and a short piece of inline code is marked whole. The pages nobody lands on,
    print and 404, take only the colour and the wordmark."""
    text = page.read_text()
    text = text.replace(
        '<meta name="theme-color" content="#ffffff">', f'<meta name="theme-color" content="{palette["bg"]}">', 1
    )
    # mdBook's edit link names the copy it built from; the page edits the source
    text = text.replace("/docs/manual/../target/site-src/", "/docs/manual/")
    brand = "evoke"
    if page.name not in UNLISTED:
        brand = '<a href="/">evoke</a>'
        text = text.replace(
            '<div class="right-buttons">\n',
            '<div class="right-buttons">\n                        <a class="site" href="/how-it-works.html">How it works</a>\n                        <a class="site" href="/examples.html">Examples</a>\n                        <a class="site start" href="/start.html">Get started</a>\n',
            1,
        )
        # after the phone's previous and next, so the way on comes before the examples and the colophon
        text = re.sub(
            r'(<nav class="nav-wrapper".*?</nav>\n)',
            lambda nav: nav[1] + AT_WORK + COLOPHON,
            text,
            count=1,
            flags=re.DOTALL,
        )
    text = text.replace(
        '<h1 class="menu-title">evoke</h1>', f'<p class="menu-title">{brand}</p>', 1
    )  # the title is the page's one heading
    # a table of pages shares one column split with the others on its page
    text = re.sub(r"<table>(\s*<thead>\s*<tr><th[^>]*>Page</th>)", r'<table class="pages">\1', text)
    text = coloured(text)
    # a short piece of inline code stays whole on a line; a long one may still wrap at its spaces
    text = re.sub(
        r"<code>([^<]*)</code>",
        lambda found: f'<code class="whole">{found[1]}</code>' if len(html_text.unescape(found[1])) <= 36 else found[0],
        text,
    )
    page.write_text(text)


def coloured(text):
    """A manual page whose transcripts and commands wear the site's terminal colours from the first paint: a text block
    with a `$ ` line is a transcript, a bash block a command. Each is coloured here, not in the browser, and marked
    `nohighlight`, which mdBook's highlighter leaves alone."""

    def span(kind, line):
        return f'<span class="{kind}">{html_text.escape(line, quote=False)}</span>'

    def score(found):
        return f'<span class="{"hi" if float(found[1]) >= 0.8 else "mid"}">{found[1]}</span>'

    def own(line):
        out = html_text.escape(line, quote=False)
        out = re.sub(r"^  ([a-z_][\w-]*)(?= (?:[a-z_]+=|·|\d\.\d\d))", r'  <span class="name">\1</span>', out)
        out = re.sub(r"\b(\d\.\d\d)\b", score, out)
        out = re.sub(r" (&gt;) ([^&<]+)$", r' \1 <span class="in">\2</span>', out)
        return f'<span class="own">{out.replace("→", """<span class="arrow">→</span>""")}</span>'

    def transcript(line):
        if line.startswith("$ "):
            return f'<span class="p">$</span> {span("in", line[2:])}'
        for mark, kind in [("+ ", "add"), ("- ", "del"), ("#", "c")]:
            if line.startswith(mark):
                return span(kind, line)
        return own(line) if line.startswith("  ") or re.fullmatch(r"\[\d\]", line) else span("out", line)

    def command(line):
        if not line.strip():
            return ""
        if line.lstrip().startswith("#"):
            return span("c", line)
        found = re.match(r"^(.*?)(\s+#.*)?$", line)
        return f'<span class="p">$</span> {span("in", found[1])}{span("c", found[2]) if found[2] else ""}'

    def block(found):
        language, body = found[1], html_text.unescape(found[2]).removesuffix("\n")
        if language == "text" and not re.search(r"^\$ ", body, re.MULTILINE):
            return found[0]
        paint = transcript if language == "text" else command
        lines = "\n".join(paint(line) for line in body.split("\n"))
        return f'<pre class="term"><code class="nohighlight">{lines}</code></pre>'

    return re.sub(r'<pre><code class="language-(text|bash)">(.*?)</code></pre>', block, text, flags=re.DOTALL)


BLOCKS = {"p", "li", "dd", "dt", "h1", "h2", "h3", "h4", "figcaption"}
BREAKS = BLOCKS | {"br", "div", "pre", "ul", "ol", "dl", "table", "tr", "td", "th", "figure", "blockquote", "hr"}
VERBATIM = {"pre", "code", "script", "style", "textarea"}


def phrased(page):
    """A page whose headings break where a reader pauses: each sentence of an h1 or h2 of plain text, and each clause of
    a sentence with a comma, becomes a span the stylesheet keeps whole while it fits, and an article stays with its
    word."""

    def clauses(sentence):
        parts = re.split(r"(?<=,)[ \t\n]+", sentence)
        return sentence if len(parts) < 2 else " ".join(f'<span class="phrase">{part}</span>' for part in parts)

    def heading(found):
        tag, attributes = found[1], found[2]
        inner = re.sub(r"[^<>]+(?=<|$)", lambda text: ARTICLE.sub("\\1\u00a0", text[0]), found[3])
        if "<" in inner:
            return f"<{tag}{attributes}>{inner}</{tag}>"
        sentences = re.split(r"(?<=[.?!;])[ \t\n]+", inner.strip())
        if len(sentences) == 1:
            return f"<{tag}{attributes}>{clauses(sentences[0])}</{tag}>"
        spans = " ".join(f'<span class="phrase">{clauses(s)}</span>' for s in sentences)
        return f"<{tag}{attributes}>{spans}</{tag}>"

    page.write_text(re.sub(r"<(h1|h2)([^>]*)>(.*?)</\1>", heading, page.read_text(), flags=re.DOTALL))


def widowless(page):
    """A page whose paragraphs, list items and headings never end in a lone word: the last two words of each are
    joined by a no-break space, whatever the width and whatever the browser. Text inside code is never touched."""
    parts = re.split(r"(<[^>]*>)", page.read_text())
    verbatim, opened = 0, []
    for i, part in enumerate(parts):
        if i % 2 == 0:
            continue
        tag = re.match(r"</?\s*([a-zA-Z][a-zA-Z0-9]*)", part)
        if tag is None:
            continue
        name, closing = tag[1].lower(), part.startswith("</")
        if name in VERBATIM:
            verbatim += -1 if closing else 1
        elif name in BLOCKS and not closing:
            opened.append((name, i))
        elif name in BLOCKS and opened and opened[-1][0] == name:
            _, start = opened.pop()
            if verbatim == 0:
                glue(parts, start, i)
    page.write_text("".join(parts))


def glue(parts, start, end):
    """The last two words between two indices of a split page joined by a no-break space, unless the break before the
    last word sits inside code, the words are joined already, or they are the only two: a two-word heading glued whole
    cannot wrap, and overflowed a phone. Only the last run of text counts, a run ending at a br or a block tag: glued
    across a block, the space before a terminal showed as a blank line."""
    runs, code = [[]], 0
    for i in range(start + 1, end):
        if i % 2:
            tag = re.match(r"</?\s*([a-zA-Z][a-zA-Z0-9]*)", parts[i])
            name = tag[1].lower() if tag else ""
            if name in VERBATIM:
                code += -1 if parts[i].startswith("</") else 1
            if name in BREAKS:
                runs.append([])
        else:
            runs[-1].extend((i, j, c, code > 0) for j, c in enumerate(parts[i]))
    chars = next((run for run in reversed(runs) if any(not c.isspace() for _, _, c, _ in run)), [])
    space = lambda c: c in " \t\n\r"
    last = next((k for k in range(len(chars) - 1, -1, -1) if not space(chars[k][2])), None)
    if last is None:
        return
    j = last
    while j >= 0 and not (space(chars[j][2]) and not chars[j][3]):
        j -= 1
    if (
        j < 0
        or len("".join(c for _, _, c, _ in chars[:j]).split()) < 2
        or any(c == "\u00a0" for _, _, c, _ in chars[j:last])
    ):
        return
    k = j
    while k > 0 and space(chars[k - 1][2]) and not chars[k - 1][3]:
        k -= 1
    edits = {}
    for n, (i, off, _, _) in enumerate(chars[k : j + 1]):
        edits.setdefault(i, []).append((off, "\u00a0" if n == 0 else ""))
    for i, changes in edits.items():
        text = list(parts[i])
        for off, new in changes:
            text[off] = new
        parts[i] = "".join(text)


def labelled(page):
    """A page whose table cells carry their column's name, so a narrow screen can stack each row and still say what
    each value is, and whose tables name their roles, so a table laid out as blocks is still read as a table."""
    text = page.read_text()

    def table(found):
        body = found[1]
        heads = [
            html_text.unescape(re.sub(r"<[^>]+>", "", head)).strip()
            for head in re.findall(r"<th>(.*?)</th>", body, re.DOTALL)
        ]

        def row(found_row):
            column = iter(range(len(heads)))

            def cell(found_cell):
                i = next(column, 0)
                label = f' data-label="{html_text.escape(heads[i])}"' if 0 < i < len(heads) else ""
                return f'<td role="cell"{label}{found_cell[1]}>'

            return re.sub(r"<td([^>]*)>", cell, found_row[0])

        body = re.sub(r"<tr>.*?</tr>", row, body, flags=re.DOTALL)
        for tag, role in [("thead", "rowgroup"), ("tbody", "rowgroup"), ("tr", "row"), ("th", "columnheader")]:
            body = body.replace(f"<{tag}>", f'<{tag} role="{role}">')
        return f'<table role="table">{body}</table>'

    page.write_text(re.sub(r"<table>(.*?)</table>", table, text, flags=re.DOTALL))


def answered(page):
    """The FAQ's questions and answers, read from the page into its FAQPage entity, so the two never drift: what a
    search engine is told is what a reader sees."""
    text = page.read_text()
    plain = lambda s: " ".join(html_text.unescape(re.sub(r"<[^>]+>", "", s)).split())
    entities = [
        {
            "@type": "Question",
            "name": plain(question),
            "acceptedAnswer": {
                "@type": "Answer",
                "text": plain(" ".join(re.findall(r"<p[^>]*>(.*?)</p>", answer, re.DOTALL))),
            },
        }
        for question, answer in re.findall(r'<div class="qa"[^>]*>\s*<h3>(.*?)</h3>(.*?)</div>', text, re.DOTALL)
    ]
    page.write_text(text.replace('"mainEntity": []', '"mainEntity": ' + json.dumps(entities, ensure_ascii=False), 1))


def changed(page, dated):
    """A dated page says when it last changed: the date of the last commit to its source, the sitemap's own, shown as
    a reader reads a date where the page shows one, and as a search engine does."""
    date = git("log", "-1", "--format=%cs", "--", str(source(page))) if dated else ""
    if not date:
        return
    shown = datetime.date.fromisoformat(date).strftime("%-d %B %Y")
    text = re.sub(
        r'<time datetime="[^"]*">[^<]*</time>', f'<time datetime="{date}">{shown}</time>', page.read_text(), count=1
    )
    page.write_text(re.sub(r'"dateModified": "[^"]*"', f'"dateModified": "{date}"', text, count=1))


def versioned(landing, format_page):
    """The landing page's structured data and the format page's status line name the version Cargo.toml names."""
    landing.write_text(
        re.sub(r'"softwareVersion": "[^"]*"', f'"softwareVersion": "{VERSION}"', landing.read_text(), count=1)
    )
    format_page.write_text(
        re.sub(
            r"as [0-9]+\.[0-9]+\.[0-9]+ implements it", f"as {VERSION} implements it", format_page.read_text(), count=1
        )
    )


def twinned():
    """Every page of the manual served beside its markdown source, README.md as index.md, so a reader that wants text
    gets the file the page was made from, its relative links resolving to the twins beside it; what a page sets for
    its search result stays out of it."""
    for page in MANUAL.rglob("*.md"):
        rel = page.relative_to(MANUAL).as_posix()
        (OUT / "manual" / ("index.md" if rel == "README.md" else rel)).write_text(SETTINGS.sub("", page.read_text(), 1))


def absolute(page):
    """A manual source with every relative link made absolute, to the page it names on the site, so the text reads,
    and cites, away from its directory."""

    def link(found):
        path, _, fragment = found[2].partition("#")
        if not path or path.startswith(("http://", "https://")):
            return found[0]
        target = (page.parent / path).resolve()
        url = published(target) if target.is_relative_to(MANUAL) else URL + target.relative_to(ROOT).as_posix()
        return f"[{found[1]}]({url}{'#' + fragment if fragment else ''})"

    return LINK.sub(link, SETTINGS.sub("", page.read_text(), 1))


def llms():
    """/llms.txt from its source in site/: the head as written, the manual's parts as sections of links to each page's
    markdown twin with the README's own line on when to read it, and the version Cargo.toml names."""
    sections, part = [], None
    for section, title, path, when in contents():
        if section != part:
            sections += ["", f"## {section}", ""]
            part = section
        sections.append(f"- [{title}]({URL}manual/{path[: -len('.md')]}.md): {when}")
    text = (SITE / "llms.txt").read_text()
    for token in ("{manual}", "{version}"):
        if text.count(token) != 1:
            sys.exit(f"site/llms.txt: {token} must appear once")
    (OUT / "llms.txt").write_text(text.replace("{manual}", "\n".join(sections).strip()).replace("{version}", VERSION))


def whole():
    """/llms-full.txt: the manual as one file, in reading order, each page under its address, every link absolute."""
    parts = [
        (
            f"# The evoke manual, in one file\n\nevoke {VERSION}. Every page of {URL}manual/ follows, in reading order, "
            f"each under its address. The index, for a reader that wants less, is {URL}llms.txt.\n"
        )
    ]
    for page in [MANUAL / "README.md"] + [MANUAL / path for _, _, path, _ in contents()]:
        text = re.sub(r'^<p align="center">.*?</p>\n\n', "", absolute(page), count=1, flags=re.DOTALL)
        parts.append(f"---\n\nSource: {published(page)}\n\n{text.strip()}\n")
    (OUT / "llms-full.txt").write_text("\n".join(parts))


def linked(pages_built):
    """Every link and source on every built page lands on a file the build wrote, and a fragment on an id that file
    has, whether the link is written from the root or from the page. External addresses are not followed."""
    ids = {}
    problems = []
    for page in pages_built:
        for target in HREF.findall(page.read_text()):
            if target.startswith(("http://", "https://", "mailto:", "data:")):
                continue
            path, _, fragment = target.partition("#")
            path = path.split("?")[0]  # a query string is the page's to read
            file = page if not path else (OUT / path.lstrip("/")) if path.startswith("/") else (page.parent / path)
            file = file.resolve()
            if file.is_dir():
                file = file / "index.html"
            if not (file.is_file() and file.is_relative_to(OUT)):
                problems.append(f"{page.relative_to(OUT)}: {target} is not served")
            elif fragment and file.suffix == ".html":
                if file not in ids:
                    ids[file] = set(ID.findall(file.read_text()))
                if fragment not in ids[file]:
                    problems.append(f"{page.relative_to(OUT)}: {target} names no anchor")
    if problems:
        sys.exit("\n".join(problems))


def served(*files):
    """Every address into evoke.build the given files name is a file the build wrote: what a model is told to fetch,
    it can fetch."""
    problems = []
    for file in files:
        for target in SITE_URL.findall(file.read_text()):
            path = target[len(URL) :].split("#")[0].rstrip(".,;:")
            if not (OUT / (path + "index.html" if path == "" or path.endswith("/") else path)).is_file():
                problems.append(f"{file.relative_to(OUT)}: {target} is not served")
    if problems:
        sys.exit("\n".join(problems))


def checked(pages):
    """What a search engine reads on every listed page, held at build: a title of at most 60 characters, a description
    of 50 to 160, a canonical address, one heading, and structured data that parses."""
    problems = []
    for page in pages:
        text = page.read_text()
        title = re.search(r"<title>(.*?)</title>", text, re.DOTALL)
        summary_line = re.search(r'<meta name="description" content="([^"]*)">', text)
        faults = []
        if title is None or len(html_text.unescape(title[1])) > 60:
            faults.append("the title")
        if summary_line is None or not 50 <= len(html_text.unescape(summary_line[1])) <= 160:
            faults.append("the description")
        if '<link rel="canonical"' not in text:
            faults.append("the canonical address")
        if len(re.findall(r"<h1[\s>]", text)) != 1:
            faults.append("one heading")
        for block in re.findall(r'<script type="application/ld\+json">(.*?)</script>', text, re.DOTALL):
            try:
                json.loads(block)
            except ValueError:
                faults.append("the structured data")
        if faults:
            problems.append(f"{page.relative_to(OUT)}: {', '.join(faults)}")
    if problems:
        sys.exit("\n".join(problems))


def structured(pages_built):
    """Every block of structured data on every built page parses as JSON and names its schema.org context and type: a
    comma out of place would drop a page's card and trail without a word."""
    problems = []
    for page in pages_built:
        for block in re.findall(r'<script type="application/ld\+json">(.*?)</script>', page.read_text(), re.DOTALL):
            try:
                data = json.loads(block)
            except json.JSONDecodeError as error:
                problems.append(f"{page.relative_to(OUT)}: structured data does not parse: {error}")
                continue
            if data.get("@context") != "https://schema.org" or not (data.get("@type") or data.get("@graph")):
                problems.append(f"{page.relative_to(OUT)}: structured data names no schema.org type")
    if problems:
        sys.exit("\n".join(problems))


def sitemap(pages, dated):
    """Every listed page, dated by the last commit that touched its source. A clone without history dates nothing:
    a search engine trusts a date only while every date is right."""
    entries = []
    for page in pages:
        date = git("log", "-1", "--format=%cs", "--", str(source(page))) if dated else ""
        entries.append(f"  <url><loc>{address(page)}</loc>{f'<lastmod>{date}</lastmod>' if date else ''}</url>")
    (OUT / "sitemap.xml").write_text(
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n' + "\n".join(entries) + "\n</urlset>\n"
    )
    (OUT / "robots.txt").write_text(f"User-agent: *\nAllow: /\n\nSitemap: {URL}sitemap.xml\n")


