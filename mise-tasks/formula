#!/bin/sh
#MISE description="Print the Homebrew formula for a version, each archive's digest taken from a release's SHA256SUMS"
# Usage: mise run formula <version> <SHA256SUMS>    → Formula/evoke.rb on stdout, for the tap evoke-build/homebrew-tap
set -eu

version=${1:?usage: mise run formula <version> <SHA256SUMS>}
sums=${2:?usage: mise run formula <version> <SHA256SUMS>}
release="https://github.com/evoke-build/evoke/releases/download/v$version"

# The digest of one target's archive; a target the file does not list is an error, never an empty string.
digest() {
  found=$(awk -v file="evoke-$1.tar.gz" '$2 == file { print $1 }' "$sums")
  [ -n "$found" ] || { echo "formula: $sums lists no evoke-$1.tar.gz" >&2; exit 1; }
  echo "$found"
}
mac_arm=$(digest aarch64-apple-darwin)
mac_intel=$(digest x86_64-apple-darwin)
linux_arm=$(digest aarch64-unknown-linux-musl)
linux_intel=$(digest x86_64-unknown-linux-musl)

cat <<RUBY
# Generated by \`mise run formula\` in evoke-build/evoke for each release; edit it there.
class Evoke < Formula
  desc "Turns a sentence into a call of a small program, chosen by a classifier"
  homepage "https://evoke.build"
  version "$version"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "$release/evoke-aarch64-apple-darwin.tar.gz"
      sha256 "$mac_arm"
    end
    on_intel do
      url "$release/evoke-x86_64-apple-darwin.tar.gz"
      sha256 "$mac_intel"
    end
  end

  on_linux do
    on_arm do
      url "$release/evoke-aarch64-unknown-linux-musl.tar.gz"
      sha256 "$linux_arm"
    end
    on_intel do
      url "$release/evoke-x86_64-unknown-linux-musl.tar.gz"
      sha256 "$linux_intel"
    end
  end

  def install
    bin.install "evoke"
  end

  test do
    assert_equal "evoke #{version}", shell_output("#{bin}/evoke --version").strip
  end
end
RUBY
